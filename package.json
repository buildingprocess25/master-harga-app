    "dotenv": "^17.4.2",
    "lucide-react": "^1.61.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "^9.3.0",
    "react-select": "^5.10.2",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@prisma/compute-sdk": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.5.0",
